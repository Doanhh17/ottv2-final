[Unit]
Description=OTTv2 always-on VPS worker with four isolated match slots
Requires=isolate.service
After=network-online.target isolate.service ottv2.service
Wants=network-online.target ottv2.service
Conflicts=ottv2-worker.service ottv2-worker-pool.service

[Service]
Type=simple
User=ottv2
Group=ottv2
WorkingDirectory=/opt/ottv2/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m ottv2.worker_pool run --config /etc/ottv2-vps-worker.json --directory /var/lib/ottv2/vps-worker-pool --slots 4 --cpu-mode shared
Restart=on-failure
RestartSec=10
TimeoutStopSec=330
KillSignal=SIGINT
Nice=5
UMask=0077

[Install]
WantedBy=multi-user.target
