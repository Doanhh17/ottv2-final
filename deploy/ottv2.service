[Unit]
Description=OTTv2 local portal and isolated match worker
Requires=isolate.service
After=network-online.target isolate.service
Wants=network-online.target

[Service]
Type=simple
User=ottv2
Group=ottv2
WorkingDirectory=/opt/ottv2/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/ottv2.env
ExecStart=/usr/bin/python3 -m ottv2.local_arena --db /var/lib/ottv2/data/queue.sqlite3 --accounts /var/lib/ottv2/data/accounts.sqlite3 --port 8765 --public-origin ${OTTV2_PUBLIC_ORIGIN}
Restart=on-failure
RestartSec=5
TimeoutStopSec=360
KillSignal=SIGINT
UMask=0077
# Isolate uses its installed setuid binary. NoNewPrivileges/PrivateUsers would break it.

[Install]
WantedBy=multi-user.target
