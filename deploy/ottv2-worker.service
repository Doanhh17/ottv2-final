[Unit]
Description=OTTv2 authenticated Isolate worker
Requires=isolate.service
After=network-online.target isolate.service
Wants=network-online.target
Conflicts=ottv2-worker-pool.service

[Service]
Type=simple
User=ottv2
Group=ottv2
WorkingDirectory=/opt/ottv2/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m ottv2.remote_worker --config /etc/ottv2-worker.json --directory /var/lib/ottv2/worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=330
KillSignal=SIGINT
UMask=0077

[Install]
WantedBy=multi-user.target
